#!/usr/bin/env bash
# Run one Ralph-loop pass with the selected coding-agent CLI.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bin/run-agent [--agent pi|claude|codex] PROMPT_FILE

Select with --agent or RALPH_AGENT. Pi is the default for compatibility.
EOF
}

agent="${RALPH_AGENT:-pi}"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --agent)
      [ "$#" -ge 2 ] || { echo "run-agent: --agent needs a value" >&2; exit 2; }
      agent="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "run-agent: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

[ "$#" -eq 1 ] || { usage >&2; exit 2; }
prompt_file="$1"
[ -r "$prompt_file" ] || { echo "run-agent: cannot read prompt file: $prompt_file" >&2; exit 2; }

case "$agent" in
  pi)
    command -v pi >/dev/null 2>&1 || { echo "run-agent: pi is not installed" >&2; exit 127; }
    # Pi's documented print mode reads a piped prompt and exits.
    pi -p < "$prompt_file"
    ;;
  claude)
    command -v claude >/dev/null 2>&1 || { echo "run-agent: claude is not installed" >&2; exit 127; }
    # Claude Code's documented print mode accepts the prompt as an argument.
    claude -p "$(< "$prompt_file")"
    ;;
  codex)
    command -v codex >/dev/null 2>&1 || { echo "run-agent: codex is not installed" >&2; exit 127; }
    # Codex exec is its non-interactive mode; this grants workspace-write approval.
    codex exec --approve-for-me "$(< "$prompt_file")"
    ;;
  *)
    echo "run-agent: unknown agent '$agent' (choose pi, claude, or codex)" >&2
    exit 2
    ;;
esac
